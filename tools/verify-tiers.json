{
  "schema": 1,
  "tiers": {
    "docs": [
      "diff-check"
    ],
    "tooling": [
      "diff-check",
      "audit-tests",
      "verify-tests"
    ],
    "frontend": [
      "diff-check",
      "audit-tests",
      "verify-tests",
      "frontend-unit",
      "web-build",
      "assets",
      "audio",
      "files-repeat",
      "default-e2e"
    ],
    "full": [
      "diff-check",
      "guarded-tests",
      "audit-tests",
      "verify-tests",
      "ci-tests",
      "release-tests",
      "hosting-tests",
      "image-tool-tests",
      "audio-tool-tests",
      "exchange-contract",
      "frontend-unit",
      "web-build",
      "assets",
      "audio",
      "files-repeat",
      "default-e2e",
      "production-smoke",
      "browser-file",
      "java-full",
      "java-results",
      "oracle-audit",
      "gate",
      "desktop-exchange",
      "hosting-smoke"
    ]
  },
  "rules": [
    {
      "patterns": [
        "docs/*.md",
        "docs/*.json",
        "README.md",
        "开发任务清单.md"
      ],
      "tier": "docs"
    },
    {
      "patterns": [
        "tools/verify.sh",
        "tools/verify.py",
        "tools/verify-tiers.json",
        "tools/audit-ci-inputs.py",
        "tools/tests/test_ci_inputs.py",
        "tools/tests/test_verify.py"
      ],
      "tier": "tooling"
    },
    {
      "patterns": [
        "tools/tests/test_web_release.py"
      ],
      "tier": "tooling",
      "extra": [
        "release-tests"
      ]
    },
    {
      "patterns": [
        "tools/tests/test_web_hosting.py"
      ],
      "tier": "tooling",
      "extra": [
        "hosting-tests"
      ]
    },
    {
      "patterns": [
        "tools/tests/test_ci_workflow.py",
        "tools/tests/test_ci_evidence.py"
      ],
      "tier": "tooling",
      "extra": [
        "ci-tests"
      ]
    },
    {
      "patterns": [
        "tools/playwright.exchange.config.mjs",
        "tools/workflow-tests/*"
      ],
      "tier": "full"
    },
    {
      "patterns": [
        "tools/tests/test_guarded_process.py",
        "tools/tests/fake-workload.py"
      ],
      "tier": "tooling",
      "extra": [
        "guarded-tests"
      ]
    },
    {
      "patterns": [
        "tools/tests/test_web_images.py"
      ],
      "tier": "tooling",
      "extra": [
        "image-tool-tests"
      ]
    },
    {
      "patterns": [
        "tools/tests/test_web_audio.py"
      ],
      "tier": "tooling",
      "extra": [
        "audio-tool-tests"
      ]
    },
    {
      "patterns": [
        "tools/tests/replay-exchange.test.mjs"
      ],
      "tier": "tooling",
      "extra": [
        "exchange-contract"
      ]
    },
    {
      "patterns": [
        "web-client/unit/*"
      ],
      "tier": "tooling",
      "extra": [
        "frontend-unit"
      ]
    },
    {
      "patterns": [
        "web-client/src/*",
        "web-client/tests/*",
        "web-client/asset-tests/*",
        "web-client/audio-tests/*",
        "web-client/index.html"
      ],
      "tier": "frontend"
    },
    {
      "patterns": [
        "web-client/src/App.vue",
        "web-client/src/main.js",
        "web-client/src/api.js",
        "web-client/src/useGuestGame.js",
        "web-client/src/characterDisplay.js",
        "web-client/src/characterNames.js",
        "web-client/src/playerVisual.js",
        "web-client/src/eventDialogue.js",
        "web-client/src/eventArtwork.js",
        "web-client/src/sceneArtwork.js",
        "web-client/src/settlementVisual.js",
        "web-client/src/GameStage.vue",
        "web-client/src/EventDialogue.vue",
        "web-client/src/StageArtwork.vue",
        "web-client/src/PlayerPortrait.vue",
        "web-client/src/AssetImage.vue",
        "web-client/src/imageAssets.js",
        "web-client/src/stageImageCache.js",
        "web-client/gate-tests/*",
        "web-client/playwright.gate.config.js"
      ],
      "tier": "frontend",
      "extra": [
        "oracle-generate",
        "oracle-audit",
        "gate"
      ]
    },
    {
      "patterns": [
        "src/*",
        "config/*",
        "web-client/public/*",
        "build.gradle",
        "settings.gradle",
        "gradle.properties",
        "gradle/*",
        "gradlew",
        "gradlew.bat",
        ".gitattributes",
        ".gitignore",
        "AGENTS.md",
        ".github/*",
        "web-client/package*.json",
        "web-client/playwright*.js",
        "tools/run-gradle-safe.sh",
        "tools/guarded-process.py",
        "tools/build-web-*.py",
        "tools/requirements-*.txt"
      ],
      "tier": "full"
    }
  ],
  "unknown": "full"
}
